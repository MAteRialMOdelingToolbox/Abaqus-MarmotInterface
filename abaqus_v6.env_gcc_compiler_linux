import os
import platform

# -------------------------------------------------------------------
# FIND MARMOT LIB DIRECTORY 
# -------------------------------------------------------------------
MarmotDir = os.environ.get('MARMOT_INSTALL_DIR', '/usr/local')
marmotLibDir = None

if 'MARMOT_INSTALL_LIBDIR' in os.environ and os.path.exists(os.path.join(os.environ['MARMOT_INSTALL_LIBDIR'], 'libMarmot.so')):
    marmotLibDir = os.path.abspath(os.environ['MARMOT_INSTALL_LIBDIR'])
else:
    _machine = platform.machine()
    
    _search_paths = [
        '/usr/local/lib',
        '/usr/local/lib64',
        '/usr/lib',
        '/usr/lib64',
    ]

    # Do not use os.listdir(). Ping the explicit file paths directly.
    for _path in _search_paths:
        _check_so = os.path.join(_path, 'libMarmot.so')
        _check_so1 = os.path.join(_path, 'libMarmot.so.1')
        
        if os.path.exists(_check_so) or os.path.exists(_check_so1):
            marmotLibDir = os.path.abspath(_path)
            break  # Found it, exit loop

if not marmotLibDir:
    raise Exception("Marmot library directory not found.")

try:
    del _machine, _search_paths, _path, _check_so, _check_so1, _f, _os_info
except NameError:
    pass

# -------------------------------------------------------------------
# FIND EIGEN DIRECTORY
# -------------------------------------------------------------------
EigenDir = None
if 'EIGEN_DIR' in os.environ:
    EigenDir = os.environ['EIGEN_DIR']
else:
    _eigen_search_paths = [
        '/usr/local/include/eigen3',
        '/usr/include/eigen3',
        '/opt/local/include/eigen3',
        '/usr/local/include',
        '/usr/include'
    ]
    
    for _path in _eigen_search_paths:
        if os.path.exists(os.path.join(_path, 'Eigen', 'Core')):
            EigenDir = _path
            break

    try:
        del _eigen_search_paths, _path
    except NameError:
        pass

if not EigenDir:
    raise EnvironmentError("Eigen library not found. Please set the EIGEN_DIR environment variable to the directory containing Eigen headers.")


# -------------------------------------------------------------------
# COMPILER AND LINKER FLAGS
# -------------------------------------------------------------------
fortCmd = "gfortran"

compile_fortran = [fortCmd,
                  '-c', '-cpp', '-fPIC','-extend-source',
                  '-DABQ_LNX86_64', '-DABQ_FORTRAN',
                  '-fautomatic',
                  '-mno-fma', 
                  '-fprotect-parens',
                  '-fstack-protector-strong',
                  '-msse3',
                  '-mavx', '-mavx2',
                  '-ffixed-line-length-none',
                   '-I%I', '%P']

cppAdds = ['-std=c++2c', '-I' + os.path.join(MarmotDir, 'include'), "-O3", "-I" + EigenDir]

linkAdds = [
    '-L' + marmotLibDir,
    '-Wl,-rpath,' + marmotLibDir, 
    '-lMarmot',
]

link_sl = [fortCmd,
           '-fPIC', '-shared','-Wl,--add-needed', 
           '%E', '-Wl,-soname,%U', '-o', '%U', '%F', '%A', '%L', '%B',
           '-Wl,-Bdynamic'] + linkAdds

link_exe = [fortCmd,
            '-fPIC',
            '-Wl,-Bdynamic', '-Wl,--add-needed', '-o', '%J', '%F', '%M', '%L', '%B', '%O'] + linkAdds

# -------------------------------------------------------------------
# SAFELY APPEND C++ FLAGS
